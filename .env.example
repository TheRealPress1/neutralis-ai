# Next.js / Supabase (frontend)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Python pipeline (backend)
# Get from: Supabase Dashboard > Settings > Database > Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Dashboard API (Python FastAPI backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# AES-256-GCM key for encrypting stored API keys (64-char hex = 32 bytes)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be the same in Next.js (Vercel) and Python environments
API_KEY_ENC_KEY=

# Discord alerts (optional -- leave empty to disable)
DISCORD_WEBHOOK_URL=
