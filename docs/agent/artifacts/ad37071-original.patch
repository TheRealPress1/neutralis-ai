diff --git a/scripts/sql/audit_phantom_positions.sql b/scripts/sql/audit_phantom_positions.sql
new file mode 100644
index 0000000000000000000000000000000000000000..ad6e7745a61f3b06e25fb3c2786f880c820b876d
--- /dev/null
+++ b/scripts/sql/audit_phantom_positions.sql
@@ -0,0 +1,72 @@
+-- Audit: closed LIVE positions whose legs never actually filled on the exchange.
+--
+-- Background: before the record_fill fix, a cross-platform arb where one leg
+-- filled and the other failed still recorded BOTH legs as positions. The
+-- unfilled ("phantom") leg has no exchange order_id on its trade. When the
+-- market resolved, that phantom leg was settled as if it had been bought,
+-- booking P&L (usually the arb's "guaranteed" edge) that never happened.
+--
+-- Run each block in the Supabase SQL editor. Nothing here modifies data;
+-- the repair statement at the bottom is commented out on purpose.
+
+-- 1) Phantom candidates: live closed positions with no trade carrying an order_id.
+WITH phantom AS (
+    SELECT p.id, p.ticker, p.event_ticker, p.venue, p.side, p.size_dollars,
+           p.quantity, p.realized_pnl, p.opened_at, p.closed_at, p.user_id
+    FROM positions p
+    WHERE p.status = 'closed'
+      AND p.is_paper IS NOT TRUE
+      AND NOT EXISTS (
+          SELECT 1 FROM trades t
+          WHERE t.ticker = p.ticker AND t.venue = p.venue AND t.side = p.side
+            AND t.is_paper = FALSE
+            AND t.order_id IS NOT NULL AND t.order_id <> ''
+      )
+)
+SELECT * FROM phantom ORDER BY closed_at DESC;
+
+-- 2) How much of the dashboard's realized P&L those phantoms account for.
+SELECT
+    COUNT(*)                                   AS phantom_positions,
+    ROUND(SUM(p.realized_pnl)::numeric, 2)     AS phantom_realized_pnl,
+    ROUND((SELECT SUM(realized_pnl) FROM positions
+           WHERE status = 'closed' AND is_paper IS NOT TRUE)::numeric, 2)
+                                               AS dashboard_realized_pnl
+FROM positions p
+WHERE p.status = 'closed'
+  AND p.is_paper IS NOT TRUE
+  AND NOT EXISTS (
+      SELECT 1 FROM trades t
+      WHERE t.ticker = p.ticker AND t.venue = p.venue AND t.side = p.side
+        AND t.is_paper = FALSE
+        AND t.order_id IS NOT NULL AND t.order_id <> ''
+  );
+
+-- 3) One-legged arbs: events where only one venue actually has an order_id.
+SELECT p.event_ticker,
+       COUNT(*)                                          AS legs_recorded,
+       COUNT(*) FILTER (WHERE t.order_id IS NOT NULL)    AS legs_with_order_id,
+       ROUND(SUM(p.realized_pnl)::numeric, 2)            AS booked_pnl
+FROM positions p
+LEFT JOIN LATERAL (
+    SELECT t.order_id FROM trades t
+    WHERE t.ticker = p.ticker AND t.venue = p.venue AND t.side = p.side
+      AND t.is_paper = FALSE AND t.order_id IS NOT NULL AND t.order_id <> ''
+    LIMIT 1
+) t ON TRUE
+WHERE p.status = 'closed' AND p.is_paper IS NOT TRUE
+GROUP BY p.event_ticker
+HAVING COUNT(*) > COUNT(*) FILTER (WHERE t.order_id IS NOT NULL)
+ORDER BY booked_pnl DESC;
+
+-- 4) Repair (review the output of 1–3 first, then uncomment).
+--    Flags phantom legs as paper so every dashboard query excludes them.
+-- UPDATE positions p SET is_paper = TRUE
+-- WHERE p.status = 'closed'
+--   AND p.is_paper IS NOT TRUE
+--   AND NOT EXISTS (
+--       SELECT 1 FROM trades t
+--       WHERE t.ticker = p.ticker AND t.venue = p.venue AND t.side = p.side
+--         AND t.is_paper = FALSE
+--         AND t.order_id IS NOT NULL AND t.order_id <> ''
+--   );
diff --git a/tests/test_portfolio_manager.py b/tests/test_portfolio_manager.py
new file mode 100644
index 0000000000000000000000000000000000000000..76d675581c70054eec98242cb32e6eb85cc7d61f
--- /dev/null
+++ b/tests/test_portfolio_manager.py
@@ -0,0 +1,162 @@
+"""Tests for PortfolioManager.record_fill live-execution accounting.
+
+Regression coverage for phantom legs: a leg that never filled on the exchange
+must not be recorded as a position, otherwise it later "settles" and books
+P&L that never happened.
+"""
+
+from __future__ import annotations
+
+from unittest.mock import MagicMock
+
+import pytest
+
+from neutralis.models import (
+    Decision,
+    DecisionVerdict,
+    GuardResult,
+    Signal,
+    SignalType,
+    TradeLeg,
+)
+from neutralis.portfolio.manager import PortfolioManager
+
+
+KALSHI = "KXEPLGAME-26APR12SUNTOT-TOT"
+POLY = "0xabc-sun-tot"
+
+
+def _signal(legs: tuple[TradeLeg, ...]) -> Signal:
+    return Signal(
+        signal_type=SignalType.CROSS_PLATFORM_DISCREPANCY,
+        ticker=KALSHI,
+        event_ticker="KXEPLGAME-26APR12SUNTOT",
+        yes_ask=0.55,
+        no_ask=0.42,
+        combined_cost=0.97,
+        gross_edge=0.03,
+        net_edge=0.03,
+        edge_pct=3.0,
+        legs=legs,
+        confidence_score=60,
+    )
+
+
+def _decision(size: float = 97.0) -> Decision:
+    return Decision(
+        signal_id="",
+        verdict=DecisionVerdict.PASS,
+        guard_results=(GuardResult(guard_name="min_edge", passed=True, value=3.0, threshold=1.0),),
+        suggested_size_dollars=size,
+        selected=True,
+        selection_score=0.5,
+    )
+
+
+@pytest.fixture
+def storage() -> MagicMock:
+    st = MagicMock()
+    st.get_open_position.return_value = None
+    st.get_open_positions.return_value = []
+    return st
+
+
+@pytest.fixture
+def manager(storage: MagicMock) -> PortfolioManager:
+    return PortfolioManager(storage)
+
+
+def _saved_trades(storage: MagicMock) -> list:
+    return [c.args[0] for c in storage.save_trade.call_args_list]
+
+
+class TestRecordFillLive:
+    def test_leg_without_execution_result_is_not_recorded(self, manager, storage):
+        """Poly filled, Kalshi failed: only the Poly leg may become a position."""
+        sig = _signal((
+            TradeLeg(ticker=KALSHI, side="yes", price_dollars=0.55, quantity_dollars=10.0, venue="kalshi"),
+            TradeLeg(ticker=POLY, side="no", price_dollars=0.42, quantity_dollars=10.0, venue="polymarket"),
+        ))
+        results = [{"success": True, "orderID": "poly-1", "ticker": POLY, "venue": "polymarket"}]
+
+        trades = manager.record_fill(sig, _decision(), 1, is_paper=False, execution_results=results)
+
+        assert [t.ticker for t in trades] == [POLY]
+        assert [t.ticker for t in _saved_trades(storage)] == [POLY]
+        assert storage.save_position.call_count == 1
+        assert storage.save_position.call_args.args[0].ticker == POLY
+
+    def test_results_match_by_ticker_not_position(self, manager, storage):
+        """Kalshi fill data must never be applied to the Poly leg via positional fallback."""
+        sig = _signal((
+            TradeLeg(ticker=POLY, side="no", price_dollars=0.42, quantity_dollars=10.0, venue="polymarket"),
+            TradeLeg(ticker=KALSHI, side="yes", price_dollars=0.55, quantity_dollars=10.0, venue="kalshi"),
+        ))
+        results = [
+            {"ticker": KALSHI, "order_id": "k-1", "status": "executed", "fill_count": 7,
+             "yes_price": 54, "no_price": 46},
+            {"success": True, "orderID": "poly-1", "ticker": POLY, "venue": "polymarket"},
+        ]
+
+        trades = {t.ticker: t for t in manager.record_fill(
+            sig, _decision(), 1, is_paper=False, execution_results=results,
+        )}
+
+        assert set(trades) == {KALSHI, POLY}
+        assert trades[KALSHI].quantity == 7
+        assert trades[KALSHI].fill_price == pytest.approx(0.54)
+        assert trades[KALSHI].size_dollars == pytest.approx(7 * 0.54, abs=0.01)
+        # Poly leg keeps its own requested sizing, not Kalshi's 7 contracts @ 46c
+        poly_size = round(97.0 * 0.42 / 0.97, 2)
+        assert trades[POLY].size_dollars == pytest.approx(poly_size)
+        assert trades[POLY].quantity == pytest.approx(poly_size / 0.42, abs=0.001)
+        assert trades[POLY].order_id == "poly-1"
+
+    def test_polymarket_result_uses_orderid_key(self, manager, storage):
+        """py-clob-client returns orderID (camel case); it must land on Trade.order_id."""
+        sig = _signal((
+            TradeLeg(ticker=POLY, side="yes", price_dollars=0.42, quantity_dollars=10.0, venue="polymarket"),
+        ))
+        results = [{"success": True, "orderID": "poly-9", "ticker": POLY}]
+        (trade,) = manager.record_fill(sig, _decision(), 1, is_paper=False, execution_results=results)
+        assert trade.order_id == "poly-9"
+
+    def test_empty_results_records_nothing(self, manager, storage):
+        sig = _signal((
+            TradeLeg(ticker=KALSHI, side="yes", price_dollars=0.55, quantity_dollars=10.0, venue="kalshi"),
+        ))
+        assert manager.record_fill(sig, _decision(), 1, is_paper=False, execution_results=[]) == []
+        storage.save_trade.assert_not_called()
+
+
+class TestRecordFillPaper:
+    def test_paper_mode_records_every_leg(self, manager, storage):
+        """No execution_results → paper accounting, all legs recorded as before."""
+        sig = _signal((
+            TradeLeg(ticker=KALSHI, side="yes", price_dollars=0.55, quantity_dollars=10.0, venue="kalshi"),
+            TradeLeg(ticker=POLY, side="no", price_dollars=0.42, quantity_dollars=10.0, venue="polymarket"),
+        ))
+        trades = manager.record_fill(sig, _decision(), 1, is_paper=True)
+        assert sorted(t.ticker for t in trades) == sorted([KALSHI, POLY])
+        assert all(t.is_paper for t in trades)
+
+
+class TestUpsertPositionPaperIsolation:
+    def test_live_trade_only_merges_into_live_position(self, manager, storage):
+        sig = _signal((
+            TradeLeg(ticker=KALSHI, side="yes", price_dollars=0.55, quantity_dollars=10.0, venue="kalshi"),
+        ))
+        manager.record_fill(
+            sig, _decision(), 1, is_paper=False,
+            execution_results=[{"ticker": KALSHI, "order_id": "k-1", "fill_count": 3, "yes_price": 55}],
+        )
+        kwargs = storage.get_open_position.call_args.kwargs
+        assert kwargs["is_paper"] is False
+
+    def test_paper_trade_only_merges_into_paper_position(self, manager, storage):
+        sig = _signal((
+            TradeLeg(ticker=KALSHI, side="yes", price_dollars=0.55, quantity_dollars=10.0, venue="kalshi"),
+        ))
+        manager.record_fill(sig, _decision(), 1, is_paper=True)
+        kwargs = storage.get_open_position.call_args.kwargs
+        assert kwargs["is_paper"] is True
