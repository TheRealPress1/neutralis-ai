 logger = get_logger(__name__)
 
 
+def _match_execution_result(
+    results: list[dict], ticker: str, venue: str,
+) -> dict | None:
+    """Find the exchange result for a leg by ticker (and venue when tagged).
+
+    Never falls back to positional matching: a Kalshi order applied to a
+    Polymarket leg (or vice versa) corrupts quantity and fill price.
+    """
+    for er in results:
+        if er.get("ticker") != ticker:
+            continue
+        er_venue = er.get("venue")
+        if er_venue and er_venue != venue:
+            continue
+        return er
+    return None
+
+
 class PortfolioManager:
     """Manages portfolio state through PostgresStorage.
 
